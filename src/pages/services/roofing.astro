---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout>

<!-- HERO SMALL -->
<section class="relative h-[40vh] flex items-center justify-center bg-gray-900 text-center">

  <img src="/roofing.webp"
       alt="Roofing Services"
       class="absolute inset-0 w-full h-full object-cover object-center opacity-80"/>

  <div class="absolute inset-0 bg-black/60"></div>

  <div class="relative z-10 px-6 animate-fadeIn">
    <h1 class="t-en text-4xl md:text-5xl font-extrabold text-white">Roofing Services</h1>
    <h1 class="t-es text-4xl md:text-5xl font-extrabold text-white">Servicios de Techado</h1>

    <p class="t-en text-gray-200 mt-3 text-lg">Trusted roofing installation & repair.</p>
    <p class="t-es text-gray-200 mt-3 text-lg">Instalación y reparación de techos confiable.</p>
  </div>
</section>

<!-- DESCRIPTION -->
<section class="py-14">
 <div class="max-w-6xl mx-auto px-4 grid md:grid-cols-2 gap-10 items-center">

   <!-- IMAGE -->
<div class="rounded-xl overflow-hidden shadow-lg h-72 md:h-96 w-full">
  <img 
    src="/ro1.webp"
    alt="Roofing Project Columbus Ohio"
    class="w-full h-full object-cover"
  />
</div>


   <!-- TEXT -->
   <div>
     <h2 class="t-en text-3xl font-bold text-indigo mb-4">Professional Roofing Services</h2>
     <h2 class="t-es text-3xl font-bold text-indigo mb-4">Servicios Profesionales de Techado</h2>

     <p class="t-en text-gray-700 mb-5 leading-relaxed">
       We provide durable roof installations, replacements, and repair services
       for residential and commercial properties. Our team ensures quality
       craftsmanship, premium materials, and long-lasting protection for your home.
     </p>

     <p class="t-es text-gray-700 mb-5 leading-relaxed">
       Ofrecemos instalaciones, reemplazos y reparaciones de techos para
       propiedades residenciales y comerciales. Garantizamos mano de obra de alta
       calidad, materiales premium y protección duradera para tu hogar.
     </p>

     <ul class="space-y-2 text-gray-700 mb-6">
       <li>✅ <span class="t-en">Roof replacement & installation</span> <span class="t-es">Instalación y reemplazo de techos</span></li>
       <li>✅ <span class="t-en">Leak detection & repair</span> <span class="t-es">Detección y reparación de goteras</span></li>
       <li>✅ <span class="t-en">Shingle & metal roofs</span> <span class="t-es">Techos de tejas y metal</span></li>
       <li>✅ <span class="t-en">Storm damage repair</span> <span class="t-es">Reparación por daños de tormenta</span></li>
       <li>✅ <span class="t-en">Licensed & insured team</span> <span class="t-es">Equipo licenciado y asegurado</span></li>
     </ul>

   </div>

 </div>
</section>

<!-- GALLERY PLACEHOLDER -->
<section class="py-16 bg-gray-50">
 <div class="max-w-6xl mx-auto px-4 text-center">
   <h2 class="t-en text-2xl font-bold text-indigo mb-6">Recent Roofing Projects</h2>
   <h2 class="t-es text-2xl font-bold text-indigo mb-6">Proyectos Recientes de Techado</h2>

   <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
     <div class="bg-gray-200 h-32 sm:h-40 rounded-xl"></div>
     <div class="bg-gray-200 h-32 sm:h-40 rounded-xl"></div>
     <div class="bg-gray-200 h-32 sm:h-40 rounded-xl"></div>
     <div class="bg-gray-200 h-32 sm:h-40 rounded-xl"></div>
   </div>
 </div>
</section>

<!-- CTA + FORM -->
<section id="quote" class="pt-20 pb-0 bg-indigo text-white relative">
  <div class="max-w-5xl mx-auto px-6 text-center animate-fadeIn pb-0 mb-0">

    <h2 class="text-3xl md:text-4xl font-bold mb-4 t-en">
      Ready To Get Started?
    </h2>
    <h2 class="text-3xl md:text-4xl font-bold mb-4 t-es">
      ¿Listo Para Comenzar?
    </h2>

    <p class="text-white/90 max-w-2xl mx-auto mb-10 t-en">
      Call us or request a free estimate using the form below.
    </p>
    <p class="text-white/90 max-w-2xl mx-auto mb-10 t-es">
      Llámanos o solicita una cotización gratis usando el formulario.
    </p>

    <!-- Call Button -->
    <a 
      href="tel:+16149840351"
      class="inline-block mb-10 px-10 py-3 rounded-full bg-white text-indigo font-semibold text-lg hover:bg-gray-100 transition"
    >
      📞 Call Now
    </a>

    <!-- Contact Form -->
    <form class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-white text-gray-800 p-8 rounded-xl shadow-lg md:col-span-2">

      <input type="text" placeholder="Your Name" required class="p-3 rounded border border-gray-300 w-full" />
      <input type="tel" placeholder="Phone Number" required class="p-3 rounded border border-gray-300 w-full" />

      <input type="text" placeholder="City / Area" required class="p-3 rounded border border-gray-300 w-full md:col-span-2" />

      <textarea placeholder="Tell us about your project..." rows="4" required class="p-3 rounded border border-gray-300 w-full md:col-span-2"></textarea>

      <button class="md:col-span-2 bg-indigo text-white py-3 rounded font-semibold hover:bg-indigo/90 transition">
        Send Request
      </button>
    </form>

  </div>

  <!-- COPYRIGHT + BUSINESS INFO -->
  <div class="text-center text-white/70 text-sm mt-10 space-y-1 pb-3 mb-0">
    <div>
      © {new Date().getFullYear()} Ozuna Construction LLC. All Rights Reserved.
    </div>
    <div class="text-white/60 text-xs">
      Licensed & Insured • Serving Columbus, OH and Surrounding Areas
    </div>
  </div>
</section>

</BaseLayout>
