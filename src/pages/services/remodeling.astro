---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "Remodeling | Ozuna Construction";
---
<BaseLayout title={title}>
  <section class="section">
    <div class="container">
      <h2 class="t-en">Remodeling</h2>
      <h2 class="t-es">Remodelaciones</h2>
      <p class="t-en">Professional remodeling services you can trust.</p>
      <p class="t-es">Servicios profesionales de remodeling en los que puedes confiar.</p>
      <div class="row" style="gap:22px;align-items:flex-start">
        <div class="card" style="flex:1;min-width:260px">
          <h3 class="t-en">What we offer</h3>
          <h3 class="t-es">Qué ofrecemos</h3>
          <ul class="t-en"><li>• Kitchens & bathrooms</li><li>• Basements</li><li>• Full home updates</li></ul>
          <ul class="t-es"><li>• Cocinas y baños</li><li>• Sótanos</li><li>• Renovaciones completas</li></ul>
          <div class="space"></div>
          <a href="/contact" class="btn btn-primary t-en">Get a Free Estimate</a>
          <a href="/contact" class="btn btn-primary t-es">Pide una Cotización</a>
        </div>
        <div class="gallery" style="flex:2">
          <div class="img"><img src="/remodeling-placeholder.svg" alt="Remodeling photo"/></div>
          <div class="img"><img src="/remodeling-placeholder.svg" alt="Remodeling photo"/></div>
          <div class="img"><img src="/remodeling-placeholder.svg" alt="Remodeling photo"/></div>
          <div class="img"><img src="/remodeling-placeholder.svg" alt="Remodeling photo"/></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
