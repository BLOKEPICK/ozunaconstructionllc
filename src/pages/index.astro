---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout>

<!-- HERO SECTION -->
<section class="relative h-[85vh] flex items-center justify-center overflow-hidden bg-gray-900">

  <!-- Background image -->
  <img 
    src="/hero1.webp"
    alt="Construction Hero Image"
    class="absolute inset-0 w-full h-full object-cover object-center"
  />

  <!-- Overlay gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/60 to-black/85"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-3xl animate-fadeIn">

    <!-- Small badge -->
    <div class="inline-block bg-white/10 backdrop-blur px-4 py-1.5 rounded-full border border-white/20 mb-4">
      <span class="text-sm font-medium text-white tracking-wide">
        ✅ Licensed & Insured Contractor
      </span>
    </div>

    <!-- Headline -->
    <h1 
      class="text-4xl md:text-6xl font-extrabold text-white leading-tight mb-4"
      data-i18n="hero_title"
    >
      Trusted Construction & Remodeling Experts
    </h1>

    <!-- Sub text -->
    <p 
      class="text-gray-200 text-lg md:text-2xl mb-8 font-medium"
      data-i18n="hero_sub"
    >
      High-quality workmanship for residential & commercial projects.
    </p>

    <!-- Supporting line -->
    <p class="text-gray-300 text-sm md:text-base mb-10 italic">
      Building trust with every project. Excellence isn’t just our goal — it's our standard.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-wrap justify-center gap-4">
      <a 
        href="#quote"
        class="px-8 py-3 rounded-full text-base font-semibold bg-indigo text-white hover:bg-indigo/90 transition shadow-xl hover:shadow-indigo/40"
        data-i18n="btn_quote"
      >
        📝 Get a Quote
      </a>
      <a 
        href="tel:+16149840351"
        class="px-8 py-3 rounded-full text-base font-semibold bg-white/10 text-white border border-white/20 hover:bg-white/20 transition"
        data-i18n="btn_call"
      >
        📞 Call Now
      </a>
      <a 
        href="https://wa.me/16149840351"
        class="px-8 py-3 rounded-full text-base font-semibold bg-green text-white hover:bg-green/90 transition shadow-lg"
        data-i18n="btn_whatsapp"
      >
        💬 WhatsApp
      </a>
    </div>

  </div>
</section>


<!-- WHY CHOOSE US -->
<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-6 text-center animate-fadeIn">

    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-6 t-en">
      Why Choose Us
    </h2>
    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-6 t-es">
      Por Qué Elegirnos
    </h2>

    <p class="text-gray-600 max-w-2xl mx-auto mb-14 t-en">
      Delivering quality craftsmanship, honest pricing, and professional results for every project.
    </p>
    <p class="text-gray-600 max-w-2xl mx-auto mb-14 t-es">
      Ofrecemos mano de obra de calidad, precios honestos y resultados profesionales en cada proyecto.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Licensed & Insured -->
      <div class="bg-gray-50 p-8 rounded-xl shadow-sm hover:shadow-lg transition">
        <div class="text-indigo text-4xl mb-4">🛡️</div>
        <h3 class="text-lg font-semibold mb-2 t-en">Licensed & Insured</h3>
        <h3 class="text-lg font-semibold mb-2 t-es">Licenciados y Asegurados</h3>
        <p class="text-gray-600 text-sm t-en">Your project is handled safely and professionally.</p>
        <p class="text-gray-600 text-sm t-es">Tu proyecto está en manos seguras y profesionales.</p>
      </div>

      <!-- Quality Craftsmanship -->
      <div class="bg-gray-50 p-8 rounded-xl shadow-sm hover:shadow-lg transition">
        <div class="text-indigo text-4xl mb-4">🧱</div>
        <h3 class="text-lg font-semibold mb-2 t-en">Quality Craftsmanship</h3>
        <h3 class="text-lg font-semibold mb-2 t-es">Calidad en Cada Detalle</h3>
        <p class="text-gray-600 text-sm t-en">We build with precision and pride in every finish.</p>
        <p class="text-gray-600 text-sm t-es">Construimos con precisión y orgullo en cada detalle.</p>
      </div>

      <!-- Fair Pricing -->
      <div class="bg-gray-50 p-8 rounded-xl shadow-sm hover:shadow-lg transition">
        <div class="text-indigo text-4xl mb-4">💵</div>
        <h3 class="text-lg font-semibold mb-2 t-en">Fair Pricing</h3>
        <h3 class="text-lg font-semibold mb-2 t-es">Precios Justos</h3>
        <p class="text-gray-600 text-sm t-en">No surprises — honest and competitive pricing.</p>
        <p class="text-gray-600 text-sm t-es">Sin sorpresas — precios honestos y competitivos.</p>
      </div>

      <!-- On-Time & Reliable -->
      <div class="bg-gray-50 p-8 rounded-xl shadow-sm hover:shadow-lg transition">
        <div class="text-indigo text-4xl mb-4">⏱️</div>
        <h3 class="text-lg font-semibold mb-2 t-en">On-Time & Reliable</h3>
        <h3 class="text-lg font-semibold mb-2 t-es">Puntualidad y Confiabilidad</h3>
        <p class="text-gray-600 text-sm t-en">We respect your time and schedule.</p>
        <p class="text-gray-600 text-sm t-es">Respetamos tu tiempo y tu agenda.</p>
      </div>

    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="py-20 bg-gray-50">
  <div class="max-w-6xl mx-auto px-6 text-center animate-fadeIn">

    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-6 t-en">
      Our Services
    </h2>
    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-6 t-es">
      Nuestros Servicios
    </h2>

    <p class="text-gray-600 max-w-2xl mx-auto mb-14 t-en">
      From small repairs to full-scale construction projects — we deliver high-quality results every time.
    </p>
    <p class="text-gray-600 max-w-2xl mx-auto mb-14 t-es">
      Desde reparaciones pequeñas hasta proyectos completos de construcción — siempre entregamos resultados de alta calidad.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

      <!-- Roofing -->
      <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg border border-gray-200 transition">
        <div class="text-4xl text-indigo mb-4">🏠</div>
        <h3 class="text-lg font-semibold mb-2 t-en">Roofing</h3>
        <h3 class="text-lg font-semibold mb-2 t-es">Techos</h3>
        <p class="text-gray-600 text-sm mb-5 t-en">Professional roof repair, replacement, and installation services.</p>
        <p class="text-gray-600 text-sm mb-5 t-es">Servicio profesional de reparación, reemplazo e instalación de techos.</p>
        <a href="/services/roofing" class="text-indigo font-medium hover:underline t-en">View Details →</a>
        <a href="/services/roofing" class="text-indigo font-medium hover:underline t-es">Ver Detalles →</a>
      </div>

      <!-- Framing -->
      <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg border border-gray-200 transition">
        <div class="text-4xl text-indigo mb-4">🪵</div>
        <h3 class="text-lg font-semibold mb-2 t-en">Framing</h3>
        <h3 class="text-lg font-semibold mb-2 t-es">Estructuras</h3>
        <p class="text-gray-600 text-sm mb-5 t-en">Expert framing for new builds, additions, & remodeling.</p>
        <p class="text-gray-600 text-sm mb-5 t-es">Estructuras profesionales para construcciones nuevas y remodelaciones.</p>
        <a href="/services/framing" class="text-indigo font-medium hover:underline t-en">View Details →</a>
        <a href="/services/framing" class="text-indigo font-medium hover:underline t-es">Ver Detalles →</a>
      </div>

      <!-- Siding -->
      <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg border border-gray-200 transition">
        <div class="text-4xl text-indigo mb-4">🏘️</div>
        <h3 class="text-lg font-semibold mb-2 t-en">Siding</h3>
        <h3 class="text-lg font-semibold mb-2 t-es">Revestimiento Exterior</h3>
        <p class="text-gray-600 text-sm mb-5 t-en">Durable and attractive siding installation & repairs.</p>
        <p class="text-gray-600 text-sm mb-5 t-es">Instalación y reparación de revestimiento exterior duradero y atractivo.</p>
        <a href="/services/siding" class="text-indigo font-medium hover:underline t-en">View Details →</a>
        <a href="/services/siding" class="text-indigo font-medium hover:underline t-es">Ver Detalles →</a>
      </div>

      <!-- Carpentry -->
      <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg border border-gray-200 transition">
        <div class="text-4xl text-indigo mb-4">🪚</div>
        <h3 class="text-lg font-semibold mb-2 t-en">Carpentry</h3>
        <h3 class="text-lg font-semibold mb-2 t-es">Carpintería</h3>
        <p class="text-gray-600 text-sm mb-5 t-en">Interior & exterior carpentry with precision craftsmanship.</p>
        <p class="text-gray-600 text-sm mb-5 t-es">Carpintería interior y exterior con precisión profesional.</p>
        <a href="/services/carpentry" class="text-indigo font-medium hover:underline t-en">View Details →</a>
        <a href="/services/carpentry" class="text-indigo font-medium hover:underline t-es">Ver Detalles →</a>
      </div>

      <!-- General Remodeling -->
      <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg border border-gray-200 transition">
        <div class="text-4xl text-indigo mb-4">🔧</div>
        <h3 class="text-lg font-semibold mb-2 t-en">Remodeling</h3>
        <h3 class="text-lg font-semibold mb-2 t-es">Remodelación</h3>
        <p class="text-gray-600 text-sm mb-5 t-en">Kitchen, bath, basement, and full home remodeling.</p>
        <p class="text-gray-600 text-sm mb-5 t-es">Cocinas, baños, sótanos y remodelación completa del hogar.</p>
        <a href="/services/remodeling" class="text-indigo font-medium hover:underline t-en">View Details →</a>
        <a href="/services/remodeling" class="text-indigo font-medium hover:underline t-es">Ver Detalles →</a>
      </div>

      <!-- Concrete / Masonry -->
      <div class="bg-white rounded-xl p-8 shadow-sm hover:shadow-lg border border-gray-200 transition">
        <div class="text-4xl text-indigo mb-4">🧱</div>
        <h3 class="text-lg font-semibold mb-2 t-en">Concrete & Masonry</h3>
        <h3 class="text-lg font-semibold mb-2 t-es">Concreto y Albañilería</h3>
        <p class="text-gray-600 text-sm mb-5 t-en">Driveways, patios, walkways, retaining walls & more.</p>
        <p class="text-gray-600 text-sm mb-5 t-es">Entradas, patios, pasarelas, muros de contención y más.</p>
        <a href="/services/concrete" class="text-indigo font-medium hover:underline t-en">View Details →</a>
        <a href="/services/concrete" class="text-indigo font-medium hover:underline t-es">Ver Detalles →</a>
      </div>

    </div>

  </div>
</section>


</BaseLayout>
