---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout>

<!-- HERO SECTION -->
<section class="relative min-h-[80vh] md:h-[85vh] flex items-center justify-center overflow-hidden bg-gray-900">

  <!-- Background image -->
  <img 
    src="/hero1.webp"
    alt="Construction Hero Image"
    class="absolute inset-0 w-full h-full object-cover object-center"
  />

  <!-- Overlay gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/65 to-black/85"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 md:px-6 max-w-3xl animate-fadeIn">

    <!-- Badge -->
    <div class="inline-block bg-white/10 backdrop-blur px-3 md:px-4 py-1.5 rounded-full border border-white/20 mb-4 md:mb-5">
      <span class="text-xs md:text-sm font-medium text-white tracking-wide">
        ✅ Licensed & Insured Contractor
      </span>
    </div>

    <!-- Main Title -->
    <h1 class="t-en text-3xl md:text-6xl font-extrabold text-white leading-tight mb-4">
      Trusted Construction & Remodeling Experts
    </h1>
    <h1 class="t-es text-3xl md:text-6xl font-extrabold text-white leading-tight mb-4 hidden">
      Expertos Confiables en Construcción & Remodelación
    </h1>

    <!-- Subtitle -->
    <p class="t-en text-gray-200 text-base md:text-xl mb-6 md:mb-8 font-medium">
      High-quality workmanship for residential & commercial projects.
    </p>
    <p class="t-es text-gray-200 text-base md:text-xl mb-6 md:mb-8 font-medium hidden">
      Mano de obra de alta calidad para proyectos residenciales y comerciales.
    </p>

    <!-- Supporting Line -->
    <p class="text-gray-300 text-xs md:text-sm mb-8 italic">
      Building trust with every project. Excellence isn’t just our goal — it's our standard.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center">

      <!-- Scroll to form -->
      <a 
        href="#quote"
        class="px-7 py-3 rounded-full text-sm md:text-base font-semibold bg-white text-indigo hover:bg-gray-100 transition shadow-md"
      >
        📝 <span class="t-en">Get a Quote</span>
        📝 <span class="t-es hidden">Obtener Cotización</span>
      </a>

      <!-- Call Now -->
      <a 
        href="tel:+16149840351"
        class="px-7 py-3 rounded-full text-sm md:text-base font-semibold bg-white/10 text-white border border-white/20 hover:bg-white/20 transition"
      >
        📞 <span class="t-en">Call Now</span>
        📞 <span class="t-es hidden">Llamar Ahora</span>
      </a>

    </div>

  </div>
</section>

<!-- smooth scroll with header offset -->
<script>
  document.addEventListener("click", (e) => {
    const link = e.target.closest('a[href^="#"]');
    if (!link) return;

    const id = link.getAttribute("href").slice(1);
    const target = document.getElementById(id);
    if (!target) return;

    e.preventDefault();

    const headerOffset = 75; // altura del header
    const y = target.getBoundingClientRect().top + window.scrollY - headerOffset;

    window.scrollTo({ top: y, behavior: "smooth" });
  });
</script>



<!-- WHY CHOOSE US -->
<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-6 animate-fadeIn">

    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-4 text-center t-en">
      Why Choose Us
    </h2>
    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-4 text-center t-es">
      Por Qué Elegirnos
    </h2>

    <p class="text-gray-600 max-w-2xl mx-auto text-center mb-12 t-en">
      Experience, reliability, and craftsmanship you can trust.
    </p>
    <p class="text-gray-600 max-w-2xl mx-auto text-center mb-12 t-es">
      Experiencia, confiabilidad y calidad en cada proyecto.
    </p>

    <!-- Items wrapper -->
    <div class="space-y-8 md:space-y-0 md:grid md:grid-cols-2 md:gap-8 md:max-w-4xl md:mx-auto">

      <!-- Item -->
      <div class="flex items-start gap-4 p-5 rounded-lg bg-gray-50 border border-gray-200 hover:bg-white transition">
        <div class="text-indigo text-4xl">🛡️</div>
        <div>
          <h3 class="font-semibold text-lg t-en">Licensed & Insured</h3>
          <h3 class="font-semibold text-lg t-es">Licenciados y Asegurados</h3>
          <p class="text-gray-600 text-sm t-en">Full protection and peace of mind.</p>
          <p class="text-gray-600 text-sm t-es">Seguridad y tranquilidad garantizadas.</p>
        </div>
      </div>

      <!-- Item -->
      <div class="flex items-start gap-4 p-5 rounded-lg bg-gray-50 border border-gray-200 hover:bg-white transition">
        <div class="text-indigo text-4xl">⭐</div>
        <div>
          <h3 class="font-semibold text-lg t-en">Quality Workmanship</h3>
          <h3 class="font-semibold text-lg t-es">Alta Calidad</h3>
          <p class="text-gray-600 text-sm t-en">Attention to detail in every job.</p>
          <p class="text-gray-600 text-sm t-es">Atención al detalle en cada trabajo.</p>
        </div>
      </div>

      <!-- Item -->
      <div class="flex items-start gap-4 p-5 rounded-lg bg-gray-50 border border-gray-200 hover:bg-white transition">
        <div class="text-indigo text-4xl">⏱️</div>
        <div>
          <h3 class="font-semibold text-lg t-en">On-Time & Reliable</h3>
          <h3 class="font-semibold text-lg t-es">Puntualidad y Confiabilidad</h3>
          <p class="text-gray-600 text-sm t-en">We respect your schedule.</p>
          <p class="text-gray-600 text-sm t-es">Respetamos tu tiempo.</p>
        </div>
      </div>

      <!-- Item -->
      <div class="flex items-start gap-4 p-5 rounded-lg bg-gray-50 border border-gray-200 hover:bg-white transition">
        <div class="text-indigo text-4xl">💰</div>
        <div>
          <h3 class="font-semibold text-lg t-en">Fair & Transparent Pricing</h3>
          <h3 class="font-semibold text-lg t-es">Precios Claros & Justos</h3>
          <p class="text-gray-600 text-sm t-en">No hidden fees, no surprises.</p>
          <p class="text-gray-600 text-sm t-es">Sin costos ocultos ni sorpresas.</p>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- SERVICES -->
<section class="py-20 bg-gray-100">
  <div class="max-w-6xl mx-auto px-6 text-center animate-fadeIn">

    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-6 t-en">
      Our Services
    </h2>
    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-6 t-es">
      Nuestros Servicios
    </h2>

    <p class="text-gray-600 max-w-2xl mx-auto mb-12 t-en">
