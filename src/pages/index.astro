---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout>
<section class="relative h-[85vh] flex items-center justify-center overflow-hidden bg-gray-900">

  <!-- Hero image (tu imagen local) -->
  <img 
  src="/hero1.webp"
  alt="Construction Hero Image"
  class="absolute inset-0 w-full h-full object-cover object-center opacity-90"
/>

  <!-- Overlay gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/60 to-black/80"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-3xl">
    <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-tight mb-4 t-en">
      Trusted Construction & Remodeling Experts
    </h1>
    <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-tight mb-4 t-es">
      Expertos Confiables en Construcción & Remodelación
    </h1>

    <p class="text-gray-200 text-lg md:text-2xl mb-8 font-medium t-en">
      High-quality workmanship for residential & commercial projects.
    </p>
    <p class="text-gray-200 text-lg md:text-2xl mb-8 font-medium t-es">
      Mano de obra de alta calidad para proyectos residenciales y comerciales.
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a href="tel:+16149840351" class="bg-indigo hover:bg-indigo/80 text-white px-8 py-3 rounded-full text-base font-semibold shadow-lg">
        📞 Call Now
      </a>
      <a href="https://wa.me/16149840351" class="bg-green hover:bg-green/80 text-white px-8 py-3 rounded-full text-base font-semibold shadow-lg">
        💬 WhatsApp
      </a>
      <a href="/services/roofing" class="bg-white text-indigo hover:bg-gray-100 px-8 py-3 rounded-full text-base font-semibold shadow-lg">
        🛠️ View Services
      </a>
    </div>
  </div>

</section>
</BaseLayout>
