---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout>

<!-- HERO SECTION -->
<section class="relative h-[85vh] flex items-center justify-center overflow-hidden bg-gray-900">

  <!-- Background image -->
  <img 
    src="/hero1.webp"
    alt="Construction Hero Image"
    class="absolute inset-0 w-full h-full object-cover object-center"
  />

  <!-- Overlay gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/60 to-black/85"></div>

  <!-- Content -->
  <div class="relative z-10 text-center px-6 max-w-3xl animate-fadeIn">

    <!-- Small badge -->
    <div class="inline-block bg-white/10 backdrop-blur px-4 py-1.5 rounded-full border border-white/20 mb-4">
      <span class="text-sm font-medium text-white tracking-wide">
        ✅ Licensed & Insured Contractor
      </span>
    </div>

    <!-- Headline -->
    <h1 
      class="text-4xl md:text-6xl font-extrabold text-white leading-tight mb-4"
      data-i18n="hero_title"
    >
      Trusted Construction & Remodeling Experts
    </h1>

    <!-- Sub text -->
    <p 
      class="text-gray-200 text-lg md:text-2xl mb-8 font-medium"
      data-i18n="hero_sub"
    >
      High-quality workmanship for residential & commercial projects.
    </p>

    <!-- Supporting line -->
    <p class="text-gray-300 text-sm md:text-base mb-10 italic">
      Building trust with every project. Excellence isn’t just our goal — it's our standard.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-wrap justify-center gap-4">
      <a 
        href="#quote"
        class="px-8 py-3 rounded-full text-base font-semibold bg-indigo text-white hover:bg-indigo/90 transition shadow-xl hover:shadow-indigo/40"
        data-i18n="btn_quote"
      >
        📝 Get a Quote
      </a>
      <a 
        href="tel:+16149840351"
        class="px-8 py-3 rounded-full text-base font-semibold bg-white/10 text-white border border-white/20 hover:bg-white/20 transition"
        data-i18n="btn_call"
      >
        📞 Call Now
      </a>
      <a 
        href="https://wa.me/16149840351"
        class="px-8 py-3 rounded-full text-base font-semibold bg-green text-white hover:bg-green/90 transition shadow-lg"
        data-i18n="btn_whatsapp"
      >
        💬 WhatsApp
      </a>
    </div>

  </div>
</section>


<!-- WHY CHOOSE US -->
<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-6 animate-fadeIn">

    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-4 text-center t-en">
      Why Choose Us
    </h2>
    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-4 text-center t-es">
      Por Qué Elegirnos
    </h2>

    <p class="text-gray-600 max-w-2xl mx-auto text-center mb-12 t-en">
      Experience, reliability, and craftsmanship you can trust.
    </p>
    <p class="text-gray-600 max-w-2xl mx-auto text-center mb-12 t-es">
      Experiencia, confiabilidad y calidad en cada proyecto.
    </p>

    <!-- Items wrapper -->
    <div class="space-y-8 md:space-y-0 md:grid md:grid-cols-2 md:gap-8 md:max-w-4xl md:mx-auto">

      <!-- Item -->
      <div class="flex items-start gap-4 p-5 rounded-lg bg-gray-50 border border-gray-200 hover:bg-white transition">
        <div class="text-indigo text-4xl">🛡️</div>
        <div>
          <h3 class="font-semibold text-lg t-en">Licensed & Insured</h3>
          <h3 class="font-semibold text-lg t-es">Licenciados y Asegurados</h3>
          <p class="text-gray-600 text-sm t-en">Full protection and peace of mind.</p>
          <p class="text-gray-600 text-sm t-es">Seguridad y tranquilidad garantizadas.</p>
        </div>
      </div>

      <!-- Item -->
      <div class="flex items-start gap-4 p-5 rounded-lg bg-gray-50 border border-gray-200 hover:bg-white transition">
        <div class="text-indigo text-4xl">⭐</div>
        <div>
          <h3 class="font-semibold text-lg t-en">Quality Workmanship</h3>
          <h3 class="font-semibold text-lg t-es">Alta Calidad</h3>
          <p class="text-gray-600 text-sm t-en">Attention to detail in every job.</p>
          <p class="text-gray-600 text-sm t-es">Atención al detalle en cada trabajo.</p>
        </div>
      </div>

      <!-- Item -->
      <div class="flex items-start gap-4 p-5 rounded-lg bg-gray-50 border border-gray-200 hover:bg-white transition">
        <div class="text-indigo text-4xl">⏱️</div>
        <div>
          <h3 class="font-semibold text-lg t-en">On-Time & Reliable</h3>
          <h3 class="font-semibold text-lg t-es">Puntualidad y Confiabilidad</h3>
          <p class="text-gray-600 text-sm t-en">We respect your schedule.</p>
          <p class="text-gray-600 text-sm t-es">Respetamos tu tiempo.</p>
        </div>
      </div>

      <!-- Item -->
      <div class="flex items-start gap-4 p-5 rounded-lg bg-gray-50 border border-gray-200 hover:bg-white transition">
        <div class="text-indigo text-4xl">💰</div>
        <div>
          <h3 class="font-semibold text-lg t-en">Fair & Transparent Pricing</h3>
          <h3 class="font-semibold text-lg t-es">Precios Claros & Justos</h3>
          <p class="text-gray-600 text-sm t-en">No hidden fees, no surprises.</p>
          <p class="text-gray-600 text-sm t-es">Sin costos ocultos ni sorpresas.</p>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- SERVICES -->
<section class="py-20 bg-gray-100">
  <div class="max-w-6xl mx-auto px-6 text-center animate-fadeIn">

    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-6 t-en">
      Our Services
    </h2>
    <h2 class="text-3xl md:text-4xl font-bold text-indigo mb-6 t-es">
      Nuestros Servicios
    </h2>

    <p class="text-gray-600 max-w-2xl mx-auto mb-12 t-en">
      We offer professional property improvement and cleaning services.
    </p>
    <p class="text-gray-600 max-w-2xl mx-auto mb-12 t-es">
      Ofrecemos servicios profesionales de mejora y limpieza de propiedades.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- Roofing -->
      <div class="bg-white rounded-xl p-8 border border-gray-200 hover:border-indigo hover:shadow-[0_0_20px_rgba(99,102,241,0.15)] transition">
        <div class="text-4xl mb-4 text-indigo">🏠</div>
        <h3 class="font-semibold text-lg mb-2 t-en">Roofing</h3>
        <h3 class="font-semibold text-lg mb-2 t-es">Techos</h3>
        <p class="text-gray-600 text-sm mb-4 t-en">Roof installation, repairs & replacement.</p>
        <p class="text-gray-600 text-sm mb-4 t-es">Instalación, reparación y reemplazo de techos.</p>
        <a href="/services/roofing" class="inline-block px-4 py-2 bg-indigo text-white rounded-full text-sm font-medium hover:bg-indigo/90 transition">
          <span class="t-en">Learn More</span>
          <span class="t-es">Más Info</span> →
        </a>
      </div>

      <!-- Pressure Washing -->
      <div class="bg-white rounded-xl p-8 border border-gray-200 hover:border-indigo hover:shadow-[0_0_20px_rgba(99,102,241,0.15)] transition">
        <div class="text-4xl mb-4 text-indigo">💧</div>
        <h3 class="font-semibold text-lg mb-2 t-en">Pressure Washing</h3>
        <h3 class="font-semibold text-lg mb-2 t-es">Limpieza a Presión</h3>
        <p class="text-gray-600 text-sm mb-4 t-en">Deep cleaning for homes, driveways & siding.</p>
        <p class="text-gray-600 text-sm mb-4 t-es">Limpieza profunda para casas, entradas y exteriores.</p>
        <a href="/services/pressure-washing" class="inline-block px-4 py-2 bg-indigo text-white rounded-full text-sm font-medium hover:bg-indigo/90 transition">
          <span class="t-en">Learn More</span>
          <span class="t-es">Más Info</span> →
        </a>
      </div>

      <!-- Remodeling -->
      <div class="bg-white rounded-xl p-8 border border-gray-200 hover:border-indigo hover:shadow-[0_0_20px_rgba(99,102,241,0.15)] transition">
        <div class="text-4xl mb-4 text-indigo">🛠️</div>
        <h3 class="font-semibold text-lg mb-2 t-en">Remodeling</h3>
        <h3 class="font-semibold text-lg mb-2 t-es">Remodelación</h3>
        <p class="text-gray-600 text-sm mb-4 t-en">Kitchen, bath, and full home remodeling.</p>
        <p class="text-gray-600 text-sm mb-4 t-es">Cocinas, baños y remodelación completa del hogar.</p>
        <a href="/services/remodeling" class="inline-block px-4 py-2 bg-indigo text-white rounded-full text-sm font-medium hover:bg-indigo/90 transition">
          <span class="t-en">Learn More</span>
          <span class="t-es">Más Info</span> →
        </a>
      </div>

      <!-- Painting -->
      <div class="bg-white rounded-xl p-8 border border-gray-200 hover:border-indigo hover:shadow-[0_0_20px_rgba(99,102,241,0.15)] transition">
        <div class="text-4xl mb-4 text-indigo">🎨</div>
        <h3 class="font-semibold text-lg mb-2 t-en">Painting</h3>
        <h3 class="font-semibold text-lg mb-2 t-es">Pintura</h3>
        <p class="text-gray-600 text-sm mb-4 t-en">Interior & exterior professional painting.</p>
        <p class="text-gray-600 text-sm mb-4 t-es">Pintura interior y exterior profesional.</p>
        <a href="/services/painting" class="inline-block px-4 py-2 bg-indigo text-white rounded-full text-sm font-medium hover:bg-indigo/90 transition">
          <span class="t-en">Learn More</span>
          <span class="t-es">Más Info</span> →
        </a>
      </div>

    </div>
  </div>
</section>

<!-- CTA + FORM -->
<section class="py-20 bg-indigo text-white relative">
  <div class="max-w-5xl mx-auto px-6 text-center animate-fadeIn">

    <h2 class="text-3xl md:text-4xl font-bold mb-4 t-en">
      Ready To Get Started?
    </h2>
    <h2 class="text-3xl md:text-4xl font-bold mb-4 t-es">
      ¿Listo Para Comenzar?
    </h2>

    <p class="text-white/90 max-w-2xl mx-auto mb-10 t-en">
      Call us or request a free estimate using the form below.
    </p>
    <p class="text-white/90 max-w-2xl mx-auto mb-10 t-es">
      Llámanos o solicita una cotización gratis usando el formulario.
    </p>

    <!-- Call Button -->
    <a 
      href="tel:+16149840351"
      class="inline-block mb-10 px-10 py-3 rounded-full bg-white text-indigo font-semibold text-lg hover:bg-gray-100 transition"
    >
      📞 Call Now
    </a>

    <!-- Contact Form -->
    <form class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-white text-gray-800 p-8 rounded-xl shadow-lg">

      <input type="text" placeholder="Your Name" required class="p-3 rounded border border-gray-300 w-full" />
      <input type="tel" placeholder="Phone Number" required class="p-3 rounded border border-gray-300 w-full" />

      <input type="text" placeholder="City / Area" required class="p-3 rounded border border-gray-300 w-full md:col-span-2" />

      <textarea placeholder="Tell us about your project..." rows="4" required class="p-3 rounded border border-gray-300 w-full md:col-span-2"></textarea>

      <button class="md:col-span-2 bg-indigo text-white py-3 rounded font-semibold hover:bg-indigo/90 transition">
        Send Request
      </button>
    </form>

  </div>

    <!-- COPYRIGHT + BUSINESS INFO -->
  <div class="text-center text-white/70 text-sm mt-14 space-y-1">
    <div>
      © {new Date().getFullYear()} Ozuna Construction LLC. All Rights Reserved.
    </div>
    <div class="text-white/60 text-xs">
      Licensed & Insured • Serving Columbus, OH and Surrounding Areas
    </div>
  </div>
</section>






</BaseLayout>
