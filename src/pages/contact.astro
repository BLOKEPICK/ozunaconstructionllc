---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Contact | Ozuna Construction">
  <section class="section">
    <div class="container">
      <h2 class="t-en">Contact Us</h2>
      <h2 class="t-es">Contáctanos</h2>
      <p class="muted t-en">Tell us about your project and we'll get back to you.</p>
      <p class="muted t-es">Cuéntanos tu proyecto y te responderemos pronto.</p>
      <div class="space"></div>
      <form action="mailto:ozunaconstructionllc@gmail.com" method="post" enctype="text/plain" class="card" style="max-width:640px">
        <div class="row" style="gap:12px">
          <input name="name" placeholder="Name / Nombre" required class="card" style="flex:1;padding:12px"/>
          <input name="phone" placeholder="Phone / Teléfono" required class="card" style="flex:1;padding:12px"/>
        </div>
        <div class="space"></div>
        <select name="service" class="card" style="width:100%;padding:12px">
          <option>Roofing</option>
          <option>Siding</option>
          <option>Framing</option>
          <option>Carpentry</option>
          <option>Remodeling</option>
        </select>
        <div class="space"></div>
        <textarea name="message" rows="5" placeholder="Message / Mensaje" class="card" style="width:100%;padding:12px"></textarea>
        <div class="space"></div>
        <button class="btn btn-primary t-en" type="submit">Send</button>
        <button class="btn btn-primary t-es" type="submit">Enviar</button>
      </form>
    </div>
  </section>
</BaseLayout>
