---
import "../styles/global.css";
export interface Props { title?: string; description?: string }
const { title="Ozuna Construction", description="Professional Construction Services" } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
</head>

<body class="bg-white text-gray-900 font-[var(--font-main)]">
<header class="sticky top-0 bg-white border-b z-30">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <a href="/" class="font-bold text-indigo text-lg">Ozuna Construction</a>
    <div class="flex items-center gap-4 text-sm">
      <button data-lang-switch class="text-gray-600 hover:text-indigo">Español / English</button>
      <a href="tel:+16149840351" class="text-gray-600 hover:text-indigo">📞 (614) 984-0351</a>
    </div>
  </div>
</header>

<main><slot /></main>

<a href="https://wa.me/16149840351"
  class="fixed bottom-5 right-5 bg-green text-white px-5 py-3 rounded-full shadow-xl font-semibold text-sm hover:bg-green/90 transition">
  💬 WhatsApp
</a>

<script src="/app.js" defer></script>
</body>
</html>
